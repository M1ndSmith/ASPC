# ASPC MQTT → Kafka bridge
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

COPY pyproject.toml README.md requirements.txt ./
COPY spc_core ./spc_core
COPY adapters ./adapters
COPY apps ./apps
COPY services ./services
COPY sample_data ./sample_data

RUN uv pip install --system --no-cache -e ".[apps,stream]" \
    && (uv pip install --system --no-cache kafka-python-ng || uv pip install --system --no-cache kafka-python)

ENV PYTHONUNBUFFERED=1

CMD ["aspc-mqtt-bridge"]
