# Copy values into the Vercel dashboard — do not commit real secrets.
# Two projects only: aspc-api (Dockerfile) + aspc-web (frontend/). No separate DB.

# --- API project ---
ASPC_AUTH_ENABLED=true
ASPC_JWT_SECRET=replace-with-long-random-string
ASPC_ADMIN_USERNAME=admin
ASPC_ADMIN_PASSWORD=replace-with-strong-password
ASPC_API_KEYS=replace-with-api-key
# After you know the frontend URL:
ASPC_CORS_ORIGINS=https://your-frontend.vercel.app

# SQLite inside the API container (ephemeral on Vercel — demo OK)
ASPC_PERSISTENCE_BACKEND=sqlite
ASPC_SQLITE_PATH=/tmp/aspc.db

# Never on a public deploy:
# ASPC_DEV_INSECURE=1

# --- Frontend project (Vercel → frontend/ root) ---
# NEXT_PUBLIC_API_URL=https://your-api.vercel.app
# NEXT_PUBLIC_WS_URL=wss://your-api.vercel.app
