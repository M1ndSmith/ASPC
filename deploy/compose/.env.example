# Copy to deploy/compose/.env and fill in real secrets before `docker compose up`.
#   cp deploy/compose/.env.example deploy/compose/.env

POSTGRES_USER=aspc
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=aspc

ASPC_JWT_SECRET=change-me-to-a-long-random-string
ASPC_API_KEYS=change-me-api-key
ASPC_ADMIN_USERNAME=admin
ASPC_ADMIN_PASSWORD=change-me-admin-password
ASPC_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
ASPC_AUTH_ENABLED=true
# Never set ASPC_DEV_INSECURE=1 in production
