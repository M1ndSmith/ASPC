# Slim ASPC API for Vercel container functions (UI + API only).
# Detected automatically when present at the repo root.
# Build locally: docker build -f Dockerfile.vercel -t aspc-api:vercel .

FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

COPY pyproject.toml README.md requirements.txt ./
COPY spc_core ./spc_core
COPY adapters ./adapters
COPY apps ./apps
COPY services ./services
COPY sample_data ./sample_data

# apps only — skip polars/plotly to keep the image lean; CSV Analyze still works.
RUN uv pip install --system --no-cache -e ".[apps]"

ENV PYTHONUNBUFFERED=1
ENV ASPC_API_HOST=0.0.0.0
ENV ASPC_API_PORT=8000
ENV ASPC_PERSISTENCE_BACKEND=sqlite
ENV ASPC_SQLITE_PATH=/tmp/aspc.db

EXPOSE 8000

CMD ["sh", "-c", "export ASPC_API_PORT=\"${PORT:-${ASPC_API_PORT:-8000}}\" && exec aspc-api"]
